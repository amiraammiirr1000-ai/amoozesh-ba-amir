# Only set these in your hosting provider's secret/environment settings. Never commit real values.
OPENAI_API_KEY=add-your-private-api-key-in-host-dashboard
OPENAI_MODEL=gpt-4.1-mini
# Use a random secret of 40+ characters; Render can generate this automatically.
TUTOR_ACCESS_TOKEN=generate-a-private-random-secret-of-at-least-40-characters
# Exact origins, comma-separated, no trailing slash. Add the hosted PWA origin when deployed.
APP_ORIGIN=https://localhost,capacitor://localhost
PORT=3000
# Set to 1 only when running behind a trusted hosting proxy.
TRUST_PROXY=0
